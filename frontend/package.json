{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "vite",
    "tauri:prepare-sidecar": "bun run scripts/prepare-tauri-sidecar.ts",
    "tauri:app": "bun run scripts/run-tauri-app.ts",
    "check:hook-order": "bun ./scripts/check-hook-order.mjs",
    "build": "bun run check:hook-order && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^7.29.13",
    "@mui/x-date-pickers": "^7.29.4",
    "@sentry/react": "^9.47.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "dayjs": "^1.11.20",
    "framer-motion": "^12.40.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@eslint/js": "^9",
    "@types/bun": "^1.3.14",
    "@vitejs/plugin-react": "^1.3.2",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "vitawind": "^2.3.0",
    "vite": "7.3.2"
  }
}

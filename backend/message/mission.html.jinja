{% set theme_colors = {
  'purple': {'primary': '#6366f1', 'secondary': '#8b5cf6', 'light': '#a78bfa'},
  'green': {'primary': '#10b981', 'secondary': '#14b8a6', 'light': '#5eead4'},
  'blue': {'primary': '#3b82f6', 'secondary': '#06b6d4', 'light': '#22d3ee'}
} %}
{% set current_theme = theme_colors[theme] if theme in theme_colors else theme_colors['purple'] %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
      body {
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
          background-color: #e8ecf0;
          margin: 0;
          padding: 20px;
          line-height: 1.6;
          color: #1a1a1a;
      }

      /* Main container */
      .container {
          max-width: 650px;
          margin: 0 auto;
          background-color: #c8d0d8;
          border-radius: 12px;
          overflow: hidden;
          border: 2px solid {{ current_theme.secondary }};
      }

      /* Header section */
      .header {
          background-color: {{ current_theme.secondary }};
          color: #ffffff;
          padding: 35px;
          text-align: center;
      }

      .header h1 {
          margin: 0;
          font-size: 32px;
          font-weight: 700;
          color: #ffffff;
      }

      .header .date {
          margin-top: 12px;
          font-size: 18px;
          color: #f1f5f9;
          font-weight: 600;
      }

      /* Content section */
      .content {
          padding: 30px;
          background-color: #c8d0d8;
          color: #1a1a1a;
      }

      /* Section with flex for title and badge */
      .section-header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 15px;
      }

      /* Status badge */
      .status-badge {
          display: inline-block;
          padding: 10px 18px;
          border-radius: 8px;
          font-weight: 700;
          font-size: 15px;
          margin: 0;
          white-space: nowrap;
      }

      .status-success {
          background-color: #4ade80;
          color: #1a1a1a;
          border: 2px solid #22c55e;
      }

      .status-warning {
          background-color: #fb7185;
          color: #1a1a1a;
          border: 2px solid #f43f5e;
      }

      /* Section */
      .section {
          margin: 30px 0;
      }

      .section-title {
          font-size: 22px;
          font-weight: 700;
          color: #1a1a1a;
          margin: 0;
      }

      /* Stats grid */
      .stats-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 20px;
          margin: 20px 0;
      }

      .stat-card {
          background-color: #b8c0c8;
          padding: 25px;
          border-radius: 12px;
          border: 2px solid {{ current_theme.secondary }};
          text-align: center;
      }

      .stat-label {
          font-size: 14px;
          color: #6c757d;
          text-transform: uppercase;
          letter-spacing: 1px;
          font-weight: 700;
          margin-bottom: 10px;
          display: block;
      }

      .stat-value {
          font-size: 42px;
          font-weight: 700;
          color: {{ current_theme.secondary }};
          margin-top: 8px;
      }

      /* Table */
      table {
          width: 100%;
          border-collapse: separate;
          border-spacing: 0;
          margin: 15px 0;
          border-radius: 12px;
          border: 2px solid {{ current_theme.secondary }};
      }

      th {
          background-color: {{ current_theme.secondary }} !important;
          color: #ffffff !important;
          padding: 18px 20px;
          text-align: left;
          font-weight: 700;
          font-size: 17px;
      }

      tbody {
          background-color: #90a8b0;
      }

      td {
          padding: 18px 20px;
          border-bottom: 1px solid #dee2e6;
          color: #1a1a1a;
          font-size: 17px;
          font-weight: 500;
      }

      tr:last-child td {
          border-bottom: none;
      }

      /* Mission status colors - subtle overlays */
      .finished {
          background-color: rgba(200, 210, 220, 0.05);
      }

      .finished td {
          color: #1a1a1a;
      }

      .unfinished {
          background-color: rgba(200, 210, 220, 0.05);
      }

      .unfinished td {
          color: #1a1a1a;
      }

      /* Status chip in table */
      .status-chip {
          display: inline-flex;
          align-items: center;
          padding: 8px 16px;
          border-radius: 6px;
          font-weight: 700;
          font-size: 16px;
          line-height: 1;
      }

      .status-chip.finished {
          background-color: #4ade80;
          color: #1a1a1a;
          border: 2px solid #22c55e;
      }

      .status-chip.unfinished {
          background-color: #fb7185;
          color: #1a1a1a;
          border: 2px solid #f43f5e;
      }

      /* Image section */
      .reward-image {
          text-align: center;
          margin: 25px 0;
          padding: 25px;
          background-color: rgba(16, 185, 129, 0.1) !important;
          border-radius: 12px;
          border: 2px solid #10b981;
      }

      .reward-image img {
          max-width: 100%;
          height: auto;
          border-radius: 8px;
      }

      /* Footer */
      .footer {
          background-color: #e5eaef;
          padding: 25px 30px;
          text-align: center;
          color: #6c757d;
          font-size: 14px;
          border-top: 2px solid {{ current_theme.secondary }};
      }

      .footer a {
          color: {{ current_theme.secondary }};
          text-decoration: none;
          font-weight: 600;
      }

      .footer a:hover {
          text-decoration: underline;
      }

      /* Icon styles */
      .icon {
          font-size: 16px;
          font-weight: bold;
          margin-right: 6px;
          display: inline-block;
          vertical-align: middle;
          line-height: 1;
      }

      .icon-success {
          color: #1a1a1a;
      }

      .icon-error {
          color: #1a1a1a;
      }
  </style>
  <title></title>
</head>
<body>
<div class="container">
  <!-- Header -->
  <div class="header">
    <h1>ZZZ Bot Daily Report</h1>
    <div class="date">{{ day }}</div>
  </div>

  <!-- Content -->
  <div class="content">
    <!-- Check-in Status -->
    <div class="section">
      <div class="section-header">
        <div class="section-title">Check-in Status</div>
        <span class="status-badge {{ 'status-success' if check_in == 'Login Success' else 'status-warning' }}">
          <span class="icon {{ 'icon-success' if check_in == 'Login Success' else 'icon-error' }}">
            {{ '&#10004;' if check_in == 'Login Success' else '&#10006;' | safe }}
          </span>
          {{ check_in }}
        </span>
      </div>
    </div>

    <!-- Login Reward Screenshot -->
    {% if check_in == "Login Success" %}
    <div class="section">
      <div class="reward-image">
        <img src="{{ login_reward_image }}" alt="Login Reward">
      </div>
    </div>
    {% endif %}

    <!-- Mission Statistics -->
    <div class="section">
      <div class="section-title">Mission Statistics</div>
      <div class="stats-grid">
        <div class="stat-card" style="background-color: #90a8b0;">
          <span class="stat-label" style="color: #1a1a1a;">Total Missions</span>
          <div class="stat-value" style="color: {{ current_theme.secondary }};">{{ missions|length }}</div>
        </div>
        <div class="stat-card" style="background-color: #90a8b0;">
          <span class="stat-label" style="color: #1a1a1a;">Completed</span>
          <div class="stat-value" style="color: {{ current_theme.secondary }};">{{ missions|selectattr('state', 'equalto', 'Finished')|list|length }}</div>
        </div>
      </div>
    </div>

    <!-- Mission Details -->
    <div class="section">
      <div class="section-title">Mission Status</div>
      <table>
        <thead>
        <tr>
          <th>Mission</th>
          <th>Status</th>
        </tr>
        </thead>
        <tbody>
        {% for mission in missions %}
          <tr class="{{ 'finished' if mission.state == 'Finished' else 'unfinished' }}">
            <td>{{ mission.name }}</td>
            <td>
              <span class="status-chip {{ 'finished' if mission.state == 'Finished' else 'unfinished' }}">
                <span class="icon {{ 'icon-success' if mission.state == 'Finished' else 'icon-error' }}">
                  {{ '&#10004;' if mission.state == 'Finished' else '&#10006;' | safe }}
                </span>
                {{ mission.state }}
              </span>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
</body>
</html>
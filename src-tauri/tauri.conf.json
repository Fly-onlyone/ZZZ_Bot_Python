{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZZZ Bot",
  "version": "0.1.26",
  "identifier": "com.zzz-bot.app",
  "mainBinaryName": "ZZZ Bot",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:3000"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://*.ingest.us.sentry.io; img-src 'self' data: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Fly",
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/zzz-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="{{ url_for('static', path='css/app.css') }}" rel="stylesheet">
    <title>Bot Scheduler</title>
</head>
<body class="bg-gray-100">
<div class="container mx-auto p-8">
    <h1 class="text-2xl font-bold mb-6">ZZZ Bot Scheduler</h1>

    <form action="/update-settings" method="post" class="space-y-4">
        <div>
            <label for="schedule_times" class="block font-medium">Schedule Times (comma-separated):</label>
            <input type="text" id="schedule_times" name="schedule_times"
                   class="mt-1 p-2 border border-gray-300 rounded w-full" value="{{ ','.join(schedule_times) }}">
        </div>

        <div class="flex items-center">
            <input type="checkbox" id="exit_after_run" name="exit_after_run" class="mr-2"
                   {% if exit_after_run %}checked{% endif %}>
            <label for="exit_after_run" class="font-medium">Close app after run</label>
        </div>

        <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded">Save Settings</button>
    </form>
</div>
</body>
</html>
